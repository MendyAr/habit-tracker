<?xml version="1.0" encoding="utf-8"?>
<!-- Tutorial / What's new: one page at a time, with Skip, Back and Next. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <TextView
        android:id="@+id/tour_skip"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_target"
        android:layout_gravity="end"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/tour_skip"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/tour_page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="48dp">

            <ImageView
                android:id="@+id/tour_icon"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_card"
                android:importantForAccessibility="no"
                android:padding="24dp" />

            <TextView
                android:id="@+id/tour_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tour_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/tour_dots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tour_back"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/tour_back"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tour_next"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/brand"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
