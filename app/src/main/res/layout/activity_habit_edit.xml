<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".habits.HabitEditActivity">

    <LinearLayout style="@style/Toolbar">

        <ImageButton
            android:id="@+id/back_button"
            style="@style/IconButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_ui_arrow_back" />

        <TextView
            android:id="@+id/edit_title"
            style="@style/ToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            tools:text="Edit habit" />

        <TextView
            android:id="@+id/save_button"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:background="?android:attr/selectableItemBackground"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/save"
            android:textColor="@color/brand"
            android:textSize="16sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="32dp">

            <ImageView
                android:id="@+id/edit_preview"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:importantForAccessibility="no" />

            <EditText
                android:id="@+id/edit_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:hint="@string/name_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="40"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <TextView
                style="@style/SectionLabel"
                android:text="@string/color" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/edit_colors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                style="@style/SectionLabel"
                android:text="@string/icon" />

            <LinearLayout
                android:id="@+id/edit_icons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="8dp" />

            <LinearLayout
                android:id="@+id/edit_home_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionLabel"
                    android:text="@string/home_screen" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/edit_add_home"
                        style="@style/ActionRow"
                        android:drawableStart="@drawable/ic_ui_add_to_home_screen"
                        android:text="@string/add_to_home" />

                    <TextView
                        android:id="@+id/edit_add_widget"
                        style="@style/ActionRow"
                        android:drawableStart="@drawable/ic_ui_widgets"
                        android:text="@string/add_widget" />

                    <Switch
                        android:id="@+id/edit_main_icon"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/main_icon_habit"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/edit_delete"
                    style="@style/ActionRow"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_card"
                    android:drawableStart="@drawable/ic_ui_delete"
                    android:drawableTint="@color/danger"
                    android:text="@string/delete_habit"
                    android:textColor="@color/danger" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
