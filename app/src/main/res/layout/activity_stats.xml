<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/stats_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".stats.StatsActivity">

    <LinearLayout style="@style/Toolbar">

        <LinearLayout
            android:id="@+id/habit_switcher"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/switch_habit"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/habit_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/habit_name"
                style="@style/ToolbarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                tools:text="Smoking" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ui_expand_more" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/edit_button"
            style="@style/IconButton"
            android:contentDescription="@string/edit_habit"
            android:src="@drawable/ic_ui_edit" />

        <ImageButton
            android:id="@+id/habits_button"
            style="@style/IconButton"
            android:contentDescription="@string/habits"
            android:src="@drawable/ic_ui_format_list_bulleted" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/stats_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="24dp">

            <!-- Period selector -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segment"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/period_day"
                    style="@style/Segment"
                    android:text="@string/period_day" />

                <TextView
                    android:id="@+id/period_week"
                    style="@style/Segment"
                    android:text="@string/period_week" />

                <TextView
                    android:id="@+id/period_month"
                    style="@style/Segment"
                    android:text="@string/period_month" />

                <TextView
                    android:id="@+id/period_year"
                    style="@style/Segment"
                    android:text="@string/period_year" />
            </LinearLayout>

            <!-- Count of the selected day / week / month / year -->
            <LinearLayout style="@style/Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/previous_button"
                        style="@style/IconButton"
                        android:contentDescription="@string/previous"
                        android:src="@drawable/ic_ui_chevron_left" />

                    <TextView
                        android:id="@+id/selected_label"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_target"
                        android:layout_weight="1"
                        android:background="?android:attr/selectableItemBackground"
                        android:gravity="center"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        tools:text="Today" />

                    <ImageButton
                        android:id="@+id/next_button"
                        style="@style/IconButton"
                        android:contentDescription="@string/next"
                        android:src="@drawable/ic_ui_chevron_right" />

                    <ImageButton
                        android:id="@+id/calendar_button"
                        style="@style/IconButton"
                        android:contentDescription="@string/pick_date"
                        android:src="@drawable/ic_ui_calendar_month" />
                </LinearLayout>

                <TextView
                    android:id="@+id/selected_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_primary"
                    android:textSize="64sp"
                    tools:text="7" />

                <TextView
                    android:id="@+id/selected_caption"
                    style="@style/Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:gravity="center"
                    tools:text="entries" />
            </LinearLayout>

            <!-- Descriptive statistics -->
            <LinearLayout style="@style/Card">

                <TextView
                    android:id="@+id/stats_title"
                    style="@style/CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Daily statistics" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/stat_average"
                        layout="@layout/item_stat" />

                    <include
                        android:id="@+id/stat_min"
                        layout="@layout/item_stat" />

                    <include
                        android:id="@+id/stat_max"
                        layout="@layout/item_stat" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/stat_std_dev"
                        layout="@layout/item_stat" />

                    <include
                        android:id="@+id/stat_variance"
                        layout="@layout/item_stat" />

                    <include
                        android:id="@+id/stat_total"
                        layout="@layout/item_stat" />
                </LinearLayout>

                <TextView
                    android:id="@+id/stats_caption"
                    style="@style/Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    tools:text="Based on 42 days · today is still running and not included" />
            </LinearLayout>

            <!-- Chart with a user-defined window -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/history" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/range_all"
                            style="@style/Chip"
                            android:text="@string/range_all" />

                        <TextView
                            android:id="@+id/range_from"
                            style="@style/Chip"
                            android:layout_marginStart="8dp"
                            tools:text="Sep 1, 2026" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="6dp"
                            android:importantForAccessibility="no"
                            android:text="@string/range_separator"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/range_to"
                            style="@style/Chip"
                            tools:text="Today" />
                    </LinearLayout>
                </HorizontalScrollView>

                <io.github.mendyar.habittracker.stats.BarChartView
                    android:id="@+id/chart"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="16dp" />
            </LinearLayout>

            <!-- Entries of the selected period -->
            <LinearLayout style="@style/Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/entries_title"
                        style="@style/CardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        tools:text="Entries · Today" />

                    <ImageButton
                        android:id="@+id/add_entry_button"
                        style="@style/IconButton"
                        android:layout_marginEnd="-12dp"
                        android:contentDescription="@string/add_entry"
                        android:src="@drawable/ic_ui_add" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/entries_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/entries_footer"
                    style="@style/Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp"
                    tools:text="Nothing logged" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
