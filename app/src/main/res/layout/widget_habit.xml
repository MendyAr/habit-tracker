<?xml version="1.0" encoding="utf-8"?>
<!--
    Resizable widget: a translucent neutral panel (widget_bg) with the habit's icon, a disc
    in its colour, in the middle. A tap opens the logging window (LogActivity).
    Duration trackers add a stopwatch badge in the corner and, while a session runs, a
    live timer under the name.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_tile" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:scaleType="centerInside"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:id="@+id/widget_label"
            style="@style/WidgetLabel"
            android:text="@string/widget_preview_name" />

        <Chronometer
            android:id="@+id/widget_timer"
            style="@style/WidgetLabel"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_badge"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />
</FrameLayout>
