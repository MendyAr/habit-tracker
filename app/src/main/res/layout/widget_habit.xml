<?xml version="1.0" encoding="utf-8"?>
<!--
    Resizable widget: a tile in the habit's colour (widget_bg, tinted at runtime) with the
    icon in the middle. Flipper child 0 is the habit, child 1 the "logged" confirmation.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_tile"
        android:tint="@color/ic_launcher_background" />

    <ViewFlipper
        android:id="@+id/widget_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inAnimation="@anim/widget_in"
        android:outAnimation="@anim/widget_out">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:id="@+id/widget_icon"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:scaleType="centerInside"
                android:src="@drawable/ic_habit_check" />

            <TextView
                android:id="@+id/widget_label"
                style="@style/WidgetLabel"
                android:text="@string/default_habit_name" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:id="@+id/widget_done"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/widget_count"
                style="@style/WidgetLabel" />
        </LinearLayout>
    </ViewFlipper>
</FrameLayout>
