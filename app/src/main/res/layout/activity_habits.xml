<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".habits.HabitsActivity">

    <LinearLayout style="@style/Toolbar">

        <ImageButton
            android:id="@+id/back_button"
            style="@style/IconButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_ui_arrow_back" />

        <TextView
            style="@style/ToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/habits" />

        <ImageButton
            android:id="@+id/add_habit_button"
            style="@style/IconButton"
            android:contentDescription="@string/new_habit"
            android:src="@drawable/ic_ui_add" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <LinearLayout
                android:id="@+id/habits_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <TextView
                style="@style/Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/habits_tip" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
