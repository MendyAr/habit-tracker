<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.Theme.HabitTracker" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:colorControlActivated">@color/brand</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:alertDialogTheme">@style/Theme.HabitTracker.Dialog</item>
        <item name="android:datePickerDialogTheme">@style/Theme.HabitTracker.Dialog</item>
        <item name="android:timePickerDialogTheme">@style/Theme.HabitTracker.Dialog</item>
    </style>

    <style name="Theme.HabitTracker.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:colorPrimary">@color/brand</item>
    </style>

    <style name="Theme.HabitTracker.Picker" parent="android:Theme.Material.Dialog">
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>
</resources>
