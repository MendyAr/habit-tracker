<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light system-bar icons on light backgrounds; flipped in values-night. -->
    <bool name="light_system_bars">true</bool>
    <!-- Android 7.0 and older have no long-press shortcuts, so a separate "Habit stats" launcher entry is shown. -->
    <bool name="needs_stats_launcher">true</bool>
    <!-- Widgets in a chosen size use extra providers hidden from the widget list, which needs Android 9. -->
    <bool name="sized_widgets">false</bool>
</resources>
